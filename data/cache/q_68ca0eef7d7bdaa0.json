{
 "sql": "SELECT h.source, h.source_id, h.name, h.url, h.organizer, h.online, h.location, h.dates_text, h.ends_at, h.prize_text, h.prize_currency, ROUND(CASE h.prize_currency WHEN 'INR' THEN h.prize_amount / f.INR WHEN 'EUR' THEN h.prize_amount / f.EUR WHEN 'GBP' THEN h.prize_amount / f.GBP ELSE h.prize_amount END, 0) AS prize_usd, h.registrations, h.themes, h.invite_only, h.state FROM scout.hackathons h CROSS JOIN scout.fx f",
